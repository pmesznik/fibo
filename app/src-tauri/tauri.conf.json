{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FIBO",
  "version": "0.4.29",
  "identifier": "pl.local.menedzerzdjec",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "FIBO", "width": 1200, "height": 720, "minWidth": 820, "minHeight": 520, "center": true, "maximized": true, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://tiles.openfreemap.org; worker-src 'self' blob:; media-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5REIxQkIzQkYxMzhBMjgKUldRb2loTy9zeHZiV2NIQTFEOWgrMVZZNXF3d0kzK05XUU8xaGIvdFNEL0Jra3AvbWtIRkFaVS8K",
      "endpoints": ["https://github.com/pmesznik/fibo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": ["models/yunet.onnx", "models/sface.onnx", "THIRD_PARTY_NOTICES.md"],
    "publisher": "FIBO",
    "shortDescription": "FIBO: menedżer i edytor zdjęć",
    "longDescription": "FIBO porządkuje zdjęcia według dat, tagów i miejsc, ma edytor z efektami, kolaże i wyszukiwanie duplikatów.",
    "copyright": "GPL-2.0-or-later",
    "category": "Photography",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Polish"],
        "customLanguageFiles": { "Polish": "installer/Polish.nsh" },
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
