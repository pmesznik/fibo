{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FIBO",
  "version": "0.1.0",
  "identifier": "pl.local.menedzerzdjec",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "FIBO", "width": 1400, "height": 880, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FIBO",
    "shortDescription": "FIBO: menedżer i edytor zdjęć",
    "longDescription": "FIBO porządkuje zdjęcia według dat, tagów i miejsc, ma edytor z efektami, kolaże i wyszukiwanie duplikatów.",
    "copyright": "GPL-2.0-or-later",
    "category": "Photography",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Polish"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
